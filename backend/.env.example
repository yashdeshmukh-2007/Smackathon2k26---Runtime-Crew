# Copy to backend/.env and fill in for your environment.

# Local Hardhat node by default; swap for Infura/Alchemy/Anvil RPC in prod.
RPC_URL=http://127.0.0.1:8545

# Address printed by your Hardhat deploy script for DonationTracker.
CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# How many blocks back sync_latest_events() looks when no from_block is given.
EVENT_POLL_BLOCK_RANGE=2000
